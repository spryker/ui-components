{
    "name": "spryker",
    "version": "0.0.0",
    "license": "MIT",
    "scripts": {
        "build": "run-s build-non-libs build-libs",
        "build-libs": "node tools/scripts/build-libs.js",
        "build-non-libs": "run-s build:*",
        "build:themes": "npm run compile:themes",
        "build:i18n": "rollup --config libs/locale/data/rollup.config.mjs",
        "build:storybook": "nx run storybook:compile --cloud=false --skip-nx-cache --output-style=stream",
        "serve:storybook": "nx run storybook:serve --cloud=false --skip-nx-cache --output-style=stream",
        "pixel:serve": "node tools/scripts/serve-storybook-static.mjs",
        "pixel:capture": "npx --no-install test-storybook --index-json --config-dir .storybook --url http://127.0.0.1:6006 --maxWorkers=2 --testTimeout=90000",
        "pixel:assert": "node tools/scripts/assert-pixel-baseline.mjs",
        "pixel:capture:current": "PIXEL_BASELINE_DIR=.pixel-current npm run pixel:capture",
        "pixel:compare": "node tools/scripts/compare-pixel-baseline.mjs",
        "pretest": "npm run clean:dist",
        "test": "npm run run:all -- test --cloud=false --skip-nx-cache --output-style=stream",
        "test:ci": "npm run run:all -- test --runInBand --cloud=false --skip-nx-cache --output-style=stream",
        "lint": "npm run run:all -- lint --cloud=false --skip-nx-cache --output-style=stream",
        "stylelint": "node ./tools/scripts/stylelint.mjs",
        "stylelint:fix": "node ./tools/scripts/stylelint.mjs --fix",
        "affected:apps": "nx affected:apps --cloud=false --skip-nx-cache --output-style=stream",
        "affected:libs": "nx affected:libs --cloud=false --skip-nx-cache --output-style=stream",
        "affected:build": "nx affected:build --cloud=false --skip-nx-cache --output-style=stream",
        "preaffected:test": "npm run clean:dist",
        "affected:test": "nx affected:test --cloud=false --skip-nx-cache --output-style=stream",
        "affected:lint": "nx affected:lint --cloud=false --skip-nx-cache --output-style=stream",
        "affected:dep-graph": "nx affected:dep-graph --cloud=false --skip-nx-cache --output-style=stream",
        "affected": "nx affected",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "run:all": "nx run-many --target",
        "hook:push": "run-s hook:push:*",
        "hook:push:format": "npm run format:check",
        "hook:push:lint": "npm run affected:lint -- --parallel",
        "hook:push:stylelint": "npm run stylelint",
        "compile:less": "lessc --js --include-path=node_modules",
        "compile:themes": "run-s compile:theme:*",
        "compile:theme:default": "npm run compile:less -- libs/styles/src/lib/themes/default/standalone.less libs/styles/src/lib/themes/default/standalone.css",
        "clean": "run-s clean:*",
        "clean:dist": "rimraf dist libs/**/dist",
        "deploy:storybook": "firebase deploy --token $FIREBASE_TOKEN --only hosting:storybook",
        "deploy:storybook:next": "firebase deploy --token $FIREBASE_TOKEN --only hosting:storybook-next",
        "pack": "run-s pack:*",
        "pack:files": "node tools/scripts/multi-copy.mjs LICENSE dist/libs/*",
        "pack:libs": "lerna exec --concurrency 1 --stream -- node \\$LERNA_ROOT_PATH/tools/scripts/pack-lib.js",
        "release": "run-s \"release:lerna -- {@}\" deploy:storybook --",
        "prerelease:lerna": "npm run pack",
        "release:lerna": "lerna publish --yes --conventional-graduate",
        "release-next": "run-s \"release-tag -- {@}\" deploy:storybook:next --",
        "prerelease-tag": "npm run pack",
        "release-tag": "lerna publish --yes --conventional-prerelease --dist-tag $GITHUB_REF_NAME --preid $GITHUB_REF_NAME",
        "postversion": "lerna exec --concurrency 1 --stream -- node \\$LERNA_ROOT_PATH/tools/scripts/update-lib.js",
        "prepare": "if [ \"$CI\" != \"true\" ]; then husky install; fi"
    },
    "private": true,
    "engines": {
        "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
        "npm": ">=10.0.0"
    },
    "dependencies": {
        "@angular/animations": "^22.1.3",
        "@angular/cdk": "^22.1.3",
        "@angular/common": "^22.1.3",
        "@angular/compiler": "^22.1.3",
        "@angular/core": "^22.1.3",
        "@angular/elements": "^22.1.3",
        "@angular/forms": "^22.1.3",
        "@angular/platform-browser": "^22.1.3",
        "@angular/platform-browser-dynamic": "^22.1.3",
        "@angular/router": "^22.1.3",
        "date-fns": "^4.1.0",
        "deepmerge": "^4.3.1",
        "ng-dynamic-component": "^11.0.0",
        "ng-zorro-antd": "^22.0.1",
        "ngx-element-boundary": "^2.0.0",
        "ngx-toastr": "^20.0.5",
        "rxjs": "^7.8.2",
        "storybook": "^10.5.10",
        "swiper": "^12.0.2",
        "tslib": "^2.8.1",
        "zone.js": "^0.15.1"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^22.1.5",
        "@angular-eslint/eslint-plugin": "^22.1.0",
        "@angular-eslint/eslint-plugin-template": "^22.1.0",
        "@angular-eslint/template-parser": "^22.1.0",
        "@angular/cli": "^22.1.5",
        "@angular/compiler-cli": "^22.1.3",
        "@angular/language-service": "^22.1.3",
        "@commitlint/cli": "^20.1.0",
        "@commitlint/config-conventional": "^20.0.0",
        "@compodoc/compodoc": "^1.1.31",
        "@ctrl/tinycolor": "^4.2.0",
        "@eslint/eslintrc": "^3.0.0",
        "@eslint/js": "^9.8.0",
        "@nx/angular": "23.1.1",
        "@nx/eslint": "23.1.1",
        "@nx/eslint-plugin": "23.1.1",
        "@nx/jest": "23.1.1",
        "@nx/storybook": "23.1.1",
        "@nx/workspace": "23.1.1",
        "@prettier/plugin-xml": "^3.4.2",
        "@rollup/plugin-commonjs": "^28.0.6",
        "@rollup/plugin-node-resolve": "^16.0.2",
        "@rollup/plugin-typescript": "^12.1.4",
        "@spryker/frontend-config.stylelint": "^0.0.6",
        "@storybook/addon-a11y": "^10.5.10",
        "@storybook/addon-designs": "^11.1.4",
        "@storybook/addon-docs": "^10.5.10",
        "@storybook/angular": "^10.5.10",
        "@storybook/test-runner": "^0.24.4",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.7.0",
        "@typescript-eslint/eslint-plugin": "^8.46.0",
        "@typescript-eslint/parser": "^8.46.0",
        "@typescript-eslint/utils": "^8.46.0",
        "@webcomponents/webcomponentsjs": "^2.8.0",
        "angular-eslint": "^22.1.0",
        "commander": "^14.0.1",
        "commitizen": "^4.3.1",
        "copyfiles": "^2.4.1",
        "cz-conventional-changelog": "^3.3.0",
        "dotenv": "^17.2.3",
        "eslint": "^9.37.0",
        "eslint-config-prettier": "^10.0.0",
        "eslint-plugin-storybook": "^10.5.10",
        "firebase-tools": "^14.18.0",
        "globby": "^15.0.0",
        "husky": "^9.1.7",
        "jest": "^30.2.0",
        "jest-environment-jsdom": "^30.2.0",
        "jest-preset-angular": "^17.0.0",
        "jest-util": "^30.2.0",
        "lerna": "^10.0.1",
        "less": "^4.4.2",
        "lint-staged": "^16.2.3",
        "ng-packagr": "^22.1.1",
        "npm-run-all2": "^8.0.4",
        "nx": "23.1.1",
        "postcss": "^8.5.6",
        "postcss-import": "^16.1.1",
        "postcss-preset-env": "^10.4.0",
        "postcss-url": "^10.1.3",
        "prettier": "^3.6.2",
        "reflect-metadata": "^0.2.2",
        "rimraf": "^6.0.1",
        "rollup": "^4.52.4",
        "stylelint": "^16.25.0",
        "stylelint-config-standard-less": "^3.0.1",
        "ts-jest": "^29.4.4",
        "ts-node": "^10.9.2",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.58.0",
        "webpack": "^5.102.0"
    },
    "overrides": {
        "ngx-toastr": {
            "@angular/core": "$@angular/core",
            "@angular/common": "$@angular/common"
        }
    },
    "config": {
        "commitizen": {
            "path": "cz-conventional-changelog"
        }
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ]
    }
}
